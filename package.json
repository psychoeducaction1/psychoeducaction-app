{
  "name": "assignations-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "lint": "eslint",
    "test": "node --import ./tests/register-aliases.mjs --test --test-isolation=none --experimental-strip-types tests/*.test.ts",
    "test:db": "node scripts/test-local-database.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "check:full": "npm run check && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.2",
    "docx": "^9.7.1",
    "lucide-react": "^1.16.0",
    "next": "^16.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
