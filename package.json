{
  "name": "assignations-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "lint": "eslint app components lib scripts tests next.config.ts eslint.config.mjs postcss.config.mjs",
    "test": "node --import ./tests/register-aliases.mjs --test --test-isolation=none --test-force-exit --experimental-strip-types tests/*.test.ts tests/*.test.mjs",
    "test:db": "node scripts/test-local-database.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "check:full": "npm run check && npm run build",
    "prebuild": "node scripts/clinical-model/prepare.mjs",
    "prebuild:staging": "node scripts/clinical-model/prepare.mjs",
    "build:staging": "next build",
    "test:db:reference": "node scripts/clinical-db/run-reference.mjs --suite=all",
    "test:db:real-isolated": "node scripts/clinical-db/run-real-isolated.mjs",
    "test:clinical:real-http": "node --import ./scripts/clinical-db/register-aliases-http.mjs --experimental-strip-types scripts/clinical-db/run-real-http-isolated.mjs",
    "test:clinical:http": "node scripts/clinical-smoke.mjs --run",
    "lab:prepare": "node scripts/clinical-local/cli.mjs prepare --fictional-only",
    "test:db:local-runtime": "node scripts/clinical-db/run-local-runtime.mjs",
    "lab:verify": "node scripts/clinical-local/cli.mjs verify --fictional-only",
    "lab:capture-runtime": "node scripts/clinical-local/cli.mjs capture-runtime --fictional-only",
    "lab:backup": "node scripts/clinical-local/cli.mjs backup --fictional-only",
    "test:db:admission": "node scripts/clinical-db/run-admission.mjs",
    "test:db:admission-calendar": "node scripts/clinical-db/run-admission-calendar.mjs",
    "test:db:calendar": "node scripts/clinical-db/run-calendar.mjs",
    "lab:apply-calendar": "node scripts/clinical-local/cli.mjs apply-calendar --fictional-only",
    "lab:apply-admission": "node scripts/clinical-local/cli.mjs apply-admission --fictional-only",
    "lab:apply-booked-assignment-email": "node scripts/clinical-local/cli.mjs apply-booked-assignment-email --fictional-only",
    "lab:apply-waiting-actions": "node scripts/clinical-local/cli.mjs apply-waiting-actions --fictional-only",
    "test:db:mandates": "node scripts/clinical-db/run-mandates.mjs",
    "lab:apply-mandates": "node scripts/clinical-local/cli.mjs apply-mandates --fictional-only",
    "lab:apply-branded-pdf": "node scripts/clinical-local/cli.mjs apply-branded-pdf --fictional-only",
    "lab:apply-mandate-pdf-presentation": "node scripts/clinical-local/cli.mjs apply-mandate-pdf-presentation --fictional-only",
    "lab:apply-mandate-catalog": "node scripts/clinical-local/cli.mjs apply-mandate-catalog --fictional-only",
    "lab:apply-service-mandate-catalog": "node scripts/clinical-local/cli.mjs apply-service-mandate-catalog --fictional-only",
    "lab:apply-finance": "node scripts/clinical-local/cli.mjs apply-finance --fictional-only",
    "lab:apply-elapsed-billing": "node scripts/clinical-local/cli.mjs apply-elapsed-billing --fictional-only",
    "lab:apply-fee-open-invoices": "node scripts/clinical-local/cli.mjs apply-fee-open-invoices --fictional-only",
    "lab:apply-billing-list": "node scripts/clinical-local/cli.mjs apply-billing-list --fictional-only",
    "test:db:billing": "node scripts/clinical-db/run-billing.mjs",
    "test:db:fees": "node scripts/clinical-db/run-fees.mjs",
    "lab:apply-activity-ux": "node scripts/clinical-local/cli.mjs apply-activity-ux --fictional-only",
    "lab:test:activity-ux": "node scripts/clinical-local/activity-ux-http.mjs run --fictional-only",
    "lab:apply-client-ux": "node scripts/clinical-local/cli.mjs apply-client-ux --fictional-only",
    "lab:test:client-ux": "node scripts/clinical-local/client-ux-http.mjs run --fictional-only",
    "build:clinical": "node scripts/clinical-model/prepare.mjs && node scripts/run-isolated.mjs build",
    "dev:clinical": "node scripts/run-isolated.mjs dev"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.2",
    "docx": "^9.7.1",
    "lucide-react": "^1.16.0",
    "next": "16.4.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "@huggingface/transformers": "4.3.2",
    "@pdf-lib/fontkit": "1.1.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "@electric-sql/pglite": "0.5.9"
  }
}
