NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admission publique WordPress
PUBLIC_INTAKE_ALLOWED_ORIGINS=https://psychoeducaction.com
PUBLIC_INTAKE_HOLD_SECRET=
PUBLIC_INTAKE_RATE_LIMIT_SALT=
TURNSTILE_SECRET_KEY=

# À utiliser uniquement en développement local sans widget Turnstile.
PUBLIC_INTAKE_BYPASS_ANTIBOT=false

# Courriels transactionnels
RESEND_API_KEY=
RESEND_FROM_EMAIL=Clinique PsychoEducAction <contact@psychoeducaction.com>

# Synchronisation quotidienne des dépenses publicitaires (serveur uniquement)
CRON_SECRET=

# Google Ads API
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Facultatif si le compte n'est pas géré par un compte administrateur Google Ads.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25
GOOGLE_ADS_INGEST_SECRET=

# Meta Marketing API
META_AD_ACCOUNT_ID=
META_ADS_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v24.0
